# ============================================================================
# Ambiente LOCAL de desenvolvimento — pronto para usar, não precisa editar nada.
#
#   cp .env.local.example .env.local   (passo a passo em SETUP.md)
#
# As chaves do Supabase abaixo são as PADRÃO do `supabase start` — idênticas em
# toda máquina, NÃO são segredos de produção. Confira a qualquer momento com:
#   supabase status -o env
#
# O docker-compose.yml injeta este arquivo inteiro no container do app
# (env_file: .env.local). Depois de editar, aplique com:
#   docker compose restart web
# ============================================================================

# --- Login do dashboard -----------------------------------------------------
# Usuário semeado por supabase/seed.sql:  admin@local  /  123456
# Segredo de assinatura do JWT de sessão (>= 32 chars). Qualquer valor serve no local.
AUTH_JWT_SECRET=dev-jwt-secret-local-troque-em-producao-0123456789

# --- Supabase LOCAL (via `supabase start`) ----------------------------------
# O código server-side roda DENTRO do container do Next, então alcança o Supabase
# (que publica as portas no host) via host.docker.internal — o docker-compose.yml
# mapeia esse nome com `extra_hosts: host.docker.internal:host-gateway`.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# O browser (chat em tempo real) roda no HOST, então usa localhost — por isso as
# duas URLs são diferentes. Não unifique: cada uma vale de um lado da fronteira.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- Dados de demonstração --------------------------------------------------
# Quantos leads o seed de demonstração cria (scripts/seed-demo.mjs).
LEAD_COUNT=120

# ============================================================================
# Integrações OPCIONAIS — deixe em branco para rodar o CRM local sem elas.
# O ambiente sobe e funciona 100% com tudo isto vazio; só preencha se for
# testar chat/WhatsApp/IA de verdade.
# ============================================================================
# n8n (webhooks de entrada/saída)
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=
# WhatsApp via uazapi (webhook de entrada) — configurado na tela /app/conexao
UAZAPI_WEBHOOK_SECRET=
# URL pública do app (para registrar webhooks; use um túnel como ngrok no local)
APP_PUBLIC_URL=http://localhost:3000
# WhatsApp: Evolution API (legado)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# WhatsApp: Meta (webhook verify)
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_DATASET_ID=
META_WABA_ID=
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=v25.0
META_DEPLOY_ENV=development
META_DISPATCH_SECRET=
META_TRACKING_CAPTURE_ENABLED=false
META_ENRICHMENT_ENABLED=false
META_CAPI_ENABLED=false
# ManyChat (relay de webhook)
MANYCHAT_WEBHOOK_RELAY_URL=
# OpenAI (transcrição de áudio no chat)
OPENAI_API_KEY=
