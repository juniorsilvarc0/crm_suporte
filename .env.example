# ============================================================================
# CRM Suporte — template de variáveis de ambiente.
# Copie para `.env.local` (gitignored) e preencha. NUNCA versione segredos.
#
#   cp .env.example .env.local
#
# Rodando em Docker: após editar, `docker compose restart web`.
# ============================================================================

# --- Login do dashboard (multiusuário via tabela app_users) -----------------
# Segredo para assinar o JWT de sessão. Obrigatório em produção (mín. 32 chars).
# Gere um aleatório:  openssl rand -base64 48
AUTH_JWT_SECRET=
# Segredo JWT do SUPABASE (o mesmo que PostgREST e Realtime validam).
# ⚠️ NÃO é o AUTH_JWT_SECRET acima: aquele assina o cookie de sessão do app,
# este assina o token curto que o NAVEGADOR usa para falar com o banco. Com os
# dois iguais, um cookie de sessão passaria a valer como credencial de banco.
# Fora de produção pode ficar vazio: cai no segredo de demonstração do compose.
SUPABASE_JWT_SECRET=

# --- Supabase ---------------------------------------------------------------
# LOCAL (via `supabase start`): rode `supabase status` para pegar as chaves.
#   - Dentro do container Next, use host.docker.internal no lugar de localhost:
#     SUPABASE_URL=http://host.docker.internal:54321
#   - No browser (NEXT_PUBLIC_*), use localhost:
#     NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# PRODUÇÃO: use a URL e as chaves do projeto no painel Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- App (URL pública) ------------------------------------------------------
# URL pública desta aplicação, usada para registrar o webhook na uazapi.
# PRECISA ser alcançável pela instância uazapi (que é remota):
#   - Produção: https://seu-dominio.com
#   - Dev local: um túnel (ex.: `ngrok http 3000`) — localhost NÃO é alcançável.
# Se vazio, o registro do webhook cai na origem da requisição (só serve se pública).
APP_PUBLIC_URL=

# --- n8n (webhooks) ---------------------------------------------------------
N8N_WEBHOOK_SECRET=
# Para onde o inbound do WhatsApp é repassado (a IA responde enquanto a conversa
# está em status='bot'; ao assumir manualmente, o repasse para).
# AGORA CONFIGURÁVEL NA UI (Configurações → Automação/Integração). Esta env é
# apenas FALLBACK, usada quando o campo da UI estiver vazio.
N8N_WEBHOOK_URL=

# --- WhatsApp: uazapi (foco atual) ------------------------------------------
# Segredo validado no webhook de entrada (?s=<secret>). A uazapi só registra
# {url, events}, sem headers custom — então o segredo viaja na query string.
# Gere um aleatório:  openssl rand -hex 32
UAZAPI_WEBHOOK_SECRET=
# As credenciais da instância (apiUrl + token) NÃO ficam em env: são inseridas
# na tela /app/conexao e persistidas em chat_integrations.config.

# --- WhatsApp: Evolution API (legado) ---------------------------------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# --- WhatsApp: Meta ---------------------------------------------------------
META_WEBHOOK_VERIFY_TOKEN=
# Segredos server-only; nunca use prefixo NEXT_PUBLIC_.
META_APP_SECRET=
META_ACCESS_TOKEN=
META_DATASET_ID=
META_WABA_ID=
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=v25.0
META_DEPLOY_ENV=development
META_DISPATCH_SECRET=
# Gates seguros de rollout. CAPI exige aprovação técnica e jurídica/LGPD.
META_TRACKING_CAPTURE_ENABLED=false
META_ENRICHMENT_ENABLED=false
META_CAPI_ENABLED=false

# --- ManyChat ---------------------------------------------------------------
MANYCHAT_WEBHOOK_RELAY_URL=

# --- OpenAI (transcrição de áudio no chat) ----------------------------------
OPENAI_API_KEY=
